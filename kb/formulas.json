    "unit": "m3/s"
   }
  ],
  "result": {
   "sym": "\\Delta Q",
   "unit": "m3/s"
  },
  "module": "red",
  "file": "GUÍA_TRABAJO_PRACTICO_PÚBLICO.xlsx",
  "page": "hoja Caudales",
  "notes": "Se aplica por circuito hasta que la suma de perdidas sea cero; el factor 1,851 corresponde a Hazen-Williams."
 },
